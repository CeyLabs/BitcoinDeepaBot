bot:
  socks_proxy:
      host: 127.0.0.1:9996
      username: test
      password: username
  tor_proxy:
      host: 127.0.0.1:9050
  http_proxy: ""
  lnurl_public_host_name: "https://mylnurl.com"
  lnurl_server: "http://127.0.0.1:5454" # or http://0.0.0.0:5454 depending on your configuration
  lnurl_image: true
  # Admin API (ban/unban, DALL-E switch, mutexes). Keep it on loopback; it will
  # refuse to start on any other address unless admin_api_token is set.
  admin_api_host: 127.0.0.1:6060
  # Optional on loopback, required elsewhere. Sent as "Authorization: Bearer <token>".
  # Generate with: openssl rand -hex 32
  admin_api_token: ""
  # Expose Go's /debug/pprof on the admin API. Profiles can contain keys; leave off.
  admin_pprof: false
  # Where /donate pays, and where /send or /tip to the bot itself is routed:
  # a lightning address (name@domain) or an https LNURL-pay URL. Leave empty to
  # turn /donate off; sends to the bot then go to the bot's own wallet.
  donate_address: ""
  # Reverse proxies whose X-Forwarded-For / X-Real-IP headers are believed.
  # Empty means loopback only; ["none"] trusts no proxy. Headers from anyone
  # else are ignored.
  trusted_proxies: ["127.0.0.1", "::1"]
telegram:
  message_dispose_duration: 10
  api_key: "1234"
  log_group_id: -1001234567890  # Telegram group chat ID where errors will be logged
  error_thread_id: 0            # Optional: specific thread ID for error messages (0 for main chat)
lnbits:
  url: "http://127.0.0.1:5000"
  admin_key: "1234"
  admin_id: "1234"  # unused on lnbits 1.x, kept for older deployments
  # ACL token scoped to /users/api/v1, required on lnbits 1.x to create users.
  # Mint one under your lnbits account's access-control settings; a wallet api
  # key does not grant account management there.
  admin_token: "1234"
  webhook_server: "http://0.0.0.0:5588"  # Local webhook server address
  webhook_public_url: "https://yourdomain.com/webhook"  # Public URL for webhooks (for reverse proxy)
  # Optional but recommended. Added to every webhook URL handed to lnbits and
  # required on incoming webhooks. Generate with: openssl rand -hex 32
  # Invoices created before you set it will not trigger callbacks, so set it
  # right after a restart. Every webhook is also verified with lnbits either way.
  webhook_secret: ""
  lnbits_public_url: "link.mylnurl.com"
database:
  db_path: "data/bot.db"
  buntdb_path: "data/bunt.db"
  transactions_path: "data/transactions.db"
  shop_buntdb_path: "data/shop.db"
  groupsdb_path: "data/groups.db"
  referrals_path: "data/referrals.db"
generate:
  open_ai_bearer_token: "token_here"
  dalle_key: "asd"
  dalle_price: 1000
  worker: 2
nostr:
  private_key: "hex private key here"

# Third-party price API configuration
# Bitcoin price is fetched in parallel from CoinGecko, CoinMarketCap, and Binance.
# First successful response wins. CoinGecko and Binance require no key.
third_party:
  coinmarketcap_api_key: "your-cmc-api-key-here"  # optional — get free key at coinmarketcap.com/api

# DCA bot integration
dca:
  wallet_username: ""  # when sats are received by this Telegram username, reset DCA retry counts
  api_url: "https://bitcoindeepa-dca-be-production.up.railway.app"

# API Configuration
api:
  # Optional. When set, every /api/v1/ endpoint (send, analytics, per-user wallet API)
  # only answers these IPs/CIDRs. Behind a reverse proxy, the proxy must be in
  # bot.trusted_proxies and pass the real client IP in X-Forwarded-For.
  allowed_networks: []
  # Telegram Mini App sending (/api/v1/p2p/*). Off by default. The sender is
  # always the user in the Mini App's signed initData. See docs/p2p-api.md.
  p2p:
    enabled: false
    max_amount: 100000        # sats per transfer
    daily_limit: 500000       # sats per sender per UTC day
    confirm_threshold: 50000  # above this, the sender confirms in the bot chat
    rate_limit_per_minute: 10
    init_data_max_age: 3600   # seconds
    spend_init_data_max_age: 600  # seconds; shorter window for /send and /invoice/pay
    max_memo_length: 280
    # Required when enabled: base64 Ed25519 public key of the Mini App server,
    # which signs every call. See docs/p2p-api.md.
    service_public_key: ""
  # Analytics API - HMAC authenticated endpoints for data export
  # Generate secrets with: openssl rand -hex 32
  analytics:
    enabled: true
    timestamp_tolerance: 300  # seconds (5 minutes)
    api_keys:
      data-team:
        name: "Data Team"
        hmac_secret: "change-me"  # generate with: openssl rand -hex 32
      # Add more keys for different consumers:
      # dashboard:
      #   name: "Internal Dashboard"
      #   hmac_secret: "change-me"  # generate with: openssl rand -hex 32

  # Send API - wallet-based HMAC authenticated endpoints
  send:
    enabled: true
    # Optional. When set, only these IPs/CIDRs may call the send API. Leave
    # empty if callers have changing IPs (HMAC still applies). The old
    # internal_network setting was never enforced and is now ignored.
    allowed_networks: []
    max_amount: 1000000
    min_amount: 1
    admin_approval_threshold: 100000
    max_memo_length: 280
    rate_limit: 60
    # How long to wait for an outgoing bolt11 payment to actually settle before
    # answering the caller. lnbits returns as soon as it has handed the payment
    # to its backend, so without this wait a payment that is still routing (or
    # never leaves the node) would be reported as a success.
    settlement_timeout: 60  # seconds
    whitelisted_wallets:
      BiccoindeepaDSA:
        username: "BiccoindeepaDSA"
        hmac_secret: "change-me"  # generate with: openssl rand -hex 32
        # admin_approval_threshold: 50000  # override global (0 or omit = use global)
        # max_amount: 500000               # override global (0 or omit = use global)
      CeycubeBank:
        username: "CeycubeBank"
        hmac_secret: "change-me"  # generate with: openssl rand -hex 32
        admin_approval_threshold: 200000   # wallet-specific: override global 100000
        max_amount: 2000000                # wallet-specific: override global 1000000
    timestamp_tolerance: 300
